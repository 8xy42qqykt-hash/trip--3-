# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Supabase credentials for cloud sync and authentication:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Generate with: npx web-push generate-vapid-keys
# Set the public key here and the matching private key as the Supabase VAPID_PRIVATE_KEY secret.
# Never expose the private key in a VITE_ variable.
VITE_VAPID_PUBLIC_KEY=""

# Optional TURN relay for calls on restrictive networks.
# TURN credentials are included in the public client build; use short-lived credentials.
VITE_TURN_URL="turn:turn.example.com:3478,turns:turn.example.com:5349"
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
